config {
  type: "table",
  schema: "kloof_silver",
  tags: ["silver", "staging", "crm", "DQ01", "DQ03", "DQ07", "SH08"],
  description: "Latest typed CRM order version after exact-duplicate removal. QA orders are flagged for exclusion from facts.",
  assertions: {
    uniqueKey: ["order_id"],
    nonNull: ["order_id", "customer_id", "order_timestamp_utc", "order_date", "updated_at_utc", "dt", "_FILE_NAME"],
    rowConditions: [
      "revenue >= 0",
      "status in ('completed', 'refunded')"
    ]
  }
}

WITH typed AS (
  SELECT
    NULLIF(TRIM(order_id), "") AS order_id,
    NULLIF(TRIM(customer_id), "") AS customer_id,
    SAFE_CAST(order_ts AS TIMESTAMP) AS order_timestamp_utc,
    NULLIF(TRIM(currency), "") AS currency,
    SAFE_CAST(subtotal AS NUMERIC) AS subtotal,
    SAFE_CAST(discount AS NUMERIC) AS discount,
    SAFE_CAST(revenue AS NUMERIC) AS revenue,
    LOWER(NULLIF(TRIM(status), "")) AS status,
    SAFE_CAST(item_count AS INT64) AS item_count,
    SAFE_CAST(updated_at AS TIMESTAMP) AS updated_at_utc,
    dt,
    _FILE_NAME
  FROM ${ref("crm_orders")}
),

exact_deduplicated AS (
  SELECT *
  FROM typed
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY
      order_id,
      customer_id,
      order_timestamp_utc,
      currency,
      subtotal,
      discount,
      revenue,
      status,
      item_count,
      updated_at_utc
    ORDER BY dt DESC, _FILE_NAME DESC
  ) = 1
),

latest_version AS (
  SELECT *
  FROM exact_deduplicated
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY order_id
    ORDER BY updated_at_utc DESC, dt DESC, _FILE_NAME DESC
  ) = 1
)

SELECT
  o.order_id,
  o.customer_id,
  o.order_timestamp_utc,
  DATE(o.order_timestamp_utc, "Africa/Johannesburg") AS order_date,
  o.currency,
  o.subtotal,
  o.discount,
  o.revenue,
  o.status,
  o.item_count,
  o.updated_at_utc,
  COALESCE(c.is_internal_customer, FALSE) OR o.revenue <= 1 AS is_test_order,
  o.dt,
  o._FILE_NAME
FROM latest_version AS o
LEFT JOIN ${ref("stg_crm_customers")} AS c
  USING (customer_id)

config {
  type: "table",
  schema: "kloof_silver",
  tags: ["silver", "staging", "google_ads", "SH07"],
  description: "Typed Google Ads click view at one row per gclid.",
  assertions: {
    uniqueKey: ["gclid"],
    nonNull: ["click_date", "gclid", "campaign_id", "ad_id", "dt", "source_file_name"]
  }
}

WITH typed AS (
  SELECT
    SAFE_CAST(segments_date AS DATE) AS click_date,
    NULLIF(TRIM(click_view_gclid), "") AS gclid,
    NULLIF(TRIM(campaign_id), "") AS campaign_id,
    NULLIF(TRIM(ad_group_id), "") AS ad_group_id,
    NULLIF(TRIM(ad_group_ad_ad_id), "") AS ad_id,
    NULLIF(TRIM(click_view_area_of_interest_city), "") AS area_of_interest_city,
    dt,
    _FILE_NAME AS source_file_name
  FROM ${ref("google_ads_clicks")}
)

SELECT *
FROM typed
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY gclid
  ORDER BY dt DESC, source_file_name DESC
) = 1

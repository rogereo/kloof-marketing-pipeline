config {
  type: "table",
  schema: "kloof_silver",
  tags: ["silver", "staging", "crm"],
  description: "Typed and deduplicated CRM order lines.",
  assertions: {
    uniqueKey: ["order_id", "sku"],
    nonNull: ["order_id", "sku", "unit_price", "quantity", "dt", "source_file_name"],
    rowConditions: [
      "unit_price >= 0",
      "quantity > 0"
    ]
  }
}

WITH typed AS (
  SELECT
    NULLIF(TRIM(order_id), "") AS order_id,
    NULLIF(TRIM(sku), "") AS sku,
    NULLIF(TRIM(product_name), "") AS product_name,
    SAFE_CAST(unit_price AS NUMERIC) AS unit_price,
    SAFE_CAST(quantity AS INT64) AS quantity,
    dt,
    _FILE_NAME AS source_file_name
  FROM ${ref("crm_order_items")}
)

SELECT *
FROM typed
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY order_id, sku
  ORDER BY dt DESC, source_file_name DESC
) = 1

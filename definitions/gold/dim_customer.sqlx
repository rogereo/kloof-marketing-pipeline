config {
  type: "table",
  schema: "kloof_gold",
  tags: ["gold", "gold_batch1", "dimension", "customer", "DQ04", "DQ07", "DQ09", "DQ12", "SH11"],
  description: "One non-internal person per customer key with all associated CRM IDs and lifecycle dates.",
  assertions: {
    uniqueKey: ["customer_key"],
    nonNull: ["customer_key", "customer_ids", "identity_count", "is_placeholder", "dt", "source_file_name"],
    rowConditions: ["identity_count > 0", "is_internal_customer = false"]
  }
}

WITH order_dates AS (
  SELECT
    customer_key,
    MIN(order_timestamp_utc) AS first_order_timestamp_utc,
    MAX(order_timestamp_utc) AS latest_order_timestamp_utc,
    COUNT(*) AS lifetime_order_count
  FROM ${ref("int_orders_attributed")}
  GROUP BY customer_key
),

customers AS (
  SELECT
    customer_key,
    ARRAY_AGG(DISTINCT customer_id ORDER BY customer_id) AS customer_ids,
    COUNT(DISTINCT customer_id) AS identity_count,
    ARRAY_AGG(city_standard IGNORE NULLS ORDER BY created_at_utc DESC LIMIT 1)[SAFE_OFFSET(0)] AS city_standard,
    MIN(created_at_utc) AS first_created_at_utc,
    MIN(created_date) AS first_created_date,
    LOGICAL_OR(COALESCE(is_guest, FALSE)) AS has_guest_identity,
    LOGICAL_OR(COALESCE(marketing_opt_in, FALSE)) AS marketing_opt_in,
    LOGICAL_AND(is_placeholder) AS is_placeholder,
    LOGICAL_OR(is_internal_customer) AS is_internal_customer,
    MAX(dt) AS dt,
    ARRAY_AGG(source_file_name ORDER BY dt DESC LIMIT 1)[OFFSET(0)] AS source_file_name
  FROM ${ref("int_customer_identity")}
  GROUP BY customer_key
)

SELECT
  c.*,
  o.first_order_timestamp_utc,
  IF(o.first_order_timestamp_utc IS NULL, NULL, DATE(o.first_order_timestamp_utc, "Africa/Johannesburg")) AS first_order_date,
  o.latest_order_timestamp_utc,
  COALESCE(o.lifetime_order_count, 0) AS lifetime_order_count
FROM customers AS c
LEFT JOIN order_dates AS o
  USING (customer_key)
WHERE NOT c.is_internal_customer

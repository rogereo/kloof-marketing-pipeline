config {
  type: "table",
  schema: "kloof_gold",
  tags: ["gold", "gold_batch1", "dimension", "ad", "gemini"],
  description: "Ad dimension combining platform metadata with Gemini-derived creative features.",
  assertions: {
    uniqueKey: ["platform", "ad_id"],
    nonNull: ["platform", "ad_id", "campaign_id", "first_seen_date", "last_seen_date", "dt", "source_file_name"]
  }
}

WITH google_ads AS (
  SELECT
    "google" AS platform,
    ad_id,
    ARRAY_AGG(campaign_id ORDER BY performance_date DESC, dt DESC LIMIT 1)[OFFSET(0)] AS campaign_id,
    ARRAY_AGG(ad_group_id ORDER BY performance_date DESC, dt DESC LIMIT 1)[OFFSET(0)] AS ad_group_id,
    ARRAY_AGG(ad_group_name ORDER BY performance_date DESC, dt DESC LIMIT 1)[OFFSET(0)] AS ad_group_name,
    CAST(NULL AS STRING) AS ad_name,
    MIN(performance_date) AS first_seen_date,
    MAX(performance_date) AS last_seen_date,
    MAX(dt) AS dt,
    ARRAY_AGG(source_file_name ORDER BY performance_date DESC, dt DESC LIMIT 1)[OFFSET(0)] AS source_file_name
  FROM ${ref("stg_google_ads_performance")}
  GROUP BY ad_id
),

meta_ads AS (
  SELECT
    "meta" AS platform,
    ad_id,
    ARRAY_AGG(campaign_id ORDER BY insight_date DESC, pulled_at_utc DESC LIMIT 1)[OFFSET(0)] AS campaign_id,
    ARRAY_AGG(adset_id ORDER BY insight_date DESC, pulled_at_utc DESC LIMIT 1)[OFFSET(0)] AS ad_group_id,
    ARRAY_AGG(adset_name ORDER BY insight_date DESC, pulled_at_utc DESC LIMIT 1)[OFFSET(0)] AS ad_group_name,
    ARRAY_AGG(ad_name ORDER BY insight_date DESC, pulled_at_utc DESC LIMIT 1)[OFFSET(0)] AS ad_name,
    MIN(insight_date) AS first_seen_date,
    MAX(insight_date) AS last_seen_date,
    MAX(dt) AS dt,
    ARRAY_AGG(source_file_name ORDER BY insight_date DESC, pulled_at_utc DESC LIMIT 1)[OFFSET(0)] AS source_file_name
  FROM ${ref("stg_meta_ads")}
  GROUP BY ad_id
),

ads AS (
  SELECT * FROM google_ads
  UNION ALL
  SELECT * FROM meta_ads
)

SELECT
  a.*,
  c.copy_text,
  c.tone,
  c.discount_pct,
  c.cta,
  c.product,
  c.extraction_method AS creative_extraction_method
FROM ads AS a
LEFT JOIN ${ref("int_creative_features")} AS c
  USING (ad_id)

config {
  type: "table",
  schema: "kloof_gold",
  tags: ["gold", "gold_batch1", "dimension", "campaign", "DQ10"],
  description: "Campaign dimension joined on stable IDs, with the latest name and complete observed name history.",
  assertions: {
    uniqueKey: ["platform", "campaign_id"],
    nonNull: ["platform", "campaign_id", "current_campaign_name", "campaign_name_history", "first_seen_date", "last_seen_date", "dt", "source_file_name"]
  }
}

WITH google_campaigns AS (
  SELECT
    "google" AS platform,
    campaign_id,
    ARRAY_AGG(campaign_name ORDER BY performance_date DESC, dt DESC LIMIT 1)[OFFSET(0)] AS current_campaign_name,
    ARRAY_AGG(DISTINCT campaign_name IGNORE NULLS ORDER BY campaign_name) AS campaign_name_history,
    MIN(performance_date) AS first_seen_date,
    MAX(performance_date) AS last_seen_date,
    MAX(dt) AS dt,
    ARRAY_AGG(source_file_name ORDER BY performance_date DESC, dt DESC LIMIT 1)[OFFSET(0)] AS source_file_name
  FROM ${ref("stg_google_ads_performance")}
  GROUP BY campaign_id
),

meta_campaigns AS (
  SELECT
    "meta" AS platform,
    campaign_id,
    ARRAY_AGG(campaign_name ORDER BY insight_date DESC, pulled_at_utc DESC LIMIT 1)[OFFSET(0)] AS current_campaign_name,
    ARRAY_AGG(DISTINCT campaign_name IGNORE NULLS ORDER BY campaign_name) AS campaign_name_history,
    MIN(insight_date) AS first_seen_date,
    MAX(insight_date) AS last_seen_date,
    MAX(dt) AS dt,
    ARRAY_AGG(source_file_name ORDER BY insight_date DESC, pulled_at_utc DESC LIMIT 1)[OFFSET(0)] AS source_file_name
  FROM ${ref("stg_meta_ads")}
  GROUP BY campaign_id
)

SELECT * FROM google_campaigns
UNION ALL
SELECT * FROM meta_campaigns

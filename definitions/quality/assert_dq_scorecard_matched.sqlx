config {
  type: "assertion",
  schema: "kloof_ops",
  tags: ["quality", "quality_batch2", "quality_scorecard"],
  description: "All twelve detected DQ counts must match the simulator truth manifest."
}

SELECT *
FROM ${ref("ops_dq_scorecard")}
WHERE status != "MATCHED"
   OR detected_count IS NULL
   OR planted_count IS NULL


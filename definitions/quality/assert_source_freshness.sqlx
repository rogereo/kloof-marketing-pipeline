config { type: "assertion", schema: "kloof_ops", tags: ["quality", "quality_freshness", "freshness"] }

WITH freshness AS (
  SELECT "google_ads_performance_raw" AS source_name, COUNTIF(dt = DATE_SUB(CURRENT_DATE("Africa/Johannesburg"), INTERVAL 1 DAY)) AS yesterday_rows FROM ${ref("google_ads_performance_raw")}
  UNION ALL SELECT "google_ads_clicks", COUNTIF(dt = DATE_SUB(CURRENT_DATE("Africa/Johannesburg"), INTERVAL 1 DAY)) FROM ${ref("google_ads_clicks")}
  UNION ALL SELECT "meta_ads_insights_raw", COUNTIF(dt = DATE_SUB(CURRENT_DATE("Africa/Johannesburg"), INTERVAL 1 DAY)) FROM ${ref("meta_ads_insights_raw")}
  UNION ALL SELECT "ga4_events", COUNTIF(dt = DATE_SUB(CURRENT_DATE("Africa/Johannesburg"), INTERVAL 1 DAY)) FROM ${ref("ga4_events")}
  UNION ALL SELECT "crm_customers", COUNTIF(dt = DATE_SUB(CURRENT_DATE("Africa/Johannesburg"), INTERVAL 1 DAY)) FROM ${ref("crm_customers")}
  UNION ALL SELECT "crm_orders", COUNTIF(dt = DATE_SUB(CURRENT_DATE("Africa/Johannesburg"), INTERVAL 1 DAY)) FROM ${ref("crm_orders")}
  UNION ALL SELECT "crm_order_items", COUNTIF(dt = DATE_SUB(CURRENT_DATE("Africa/Johannesburg"), INTERVAL 1 DAY)) FROM ${ref("crm_order_items")}
  UNION ALL SELECT "creative_copy_raw", COUNTIF(dt = DATE_SUB(CURRENT_DATE("Africa/Johannesburg"), INTERVAL 1 DAY)) FROM ${ref("creative_copy_raw")}
  UNION ALL SELECT "weather_daily", COUNTIF(dt = DATE_SUB(CURRENT_DATE("Africa/Johannesburg"), INTERVAL 1 DAY)) FROM ${ref("weather_daily")}
  UNION ALL SELECT "fx_rates", COUNTIF(dt = DATE_SUB(CURRENT_DATE("Africa/Johannesburg"), INTERVAL 1 DAY)) FROM ${ref("fx_rates")}
)
SELECT * FROM freshness WHERE yesterday_rows = 0

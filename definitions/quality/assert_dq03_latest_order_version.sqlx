config { type: "assertion", schema: "kloof_ops", tags: ["quality", "quality_batch1", "DQ03"] }

SELECT order_id, "duplicate_latest_version" AS failure_reason
FROM ${ref("stg_crm_orders")}
GROUP BY order_id
HAVING COUNT(*) > 1

UNION ALL

SELECT order_id, "refunded_order_counted_as_revenue"
FROM ${ref("fct_orders")}
WHERE status = "refunded" AND completed_revenue != 0

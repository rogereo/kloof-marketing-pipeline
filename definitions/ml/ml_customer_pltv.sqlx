config {
  type: "table",
  schema: "kloof_gold",
  tags: ["gold", "gold_batch3", "ml", "prediction", "pltv"],
  description: "Predicted 90-day future customer value for every customer observed for at least seven days, segmented into high, steady and low value tiers.",
  assertions: {
    uniqueKey: ["customer_key"],
    nonNull: [
      "customer_key",
      "acquisition_date",
      "predicted_future_value_90d",
      "value_segment",
      "scored_at_utc",
      "dt",
      "source_file_name"
    ],
    rowConditions: [
      "predicted_future_value_90d >= 0",
      "value_segment in ('high', 'steady', 'low')"
    ]
  }
}

WITH data_end AS (
  SELECT MAX(calendar_date) AS max_observed_date
  FROM ${ref("dim_date")}
),

predictions AS (
  SELECT
    customer_key,
    acquisition_date,
    city_standard_output AS city_standard,
    acquisition_platform_output AS acquisition_platform,
    acquisition_campaign_id,
    acquisition_ad_id,
    acquisition_attribution_method_output AS acquisition_attribution_method,
    completed_revenue_7d,
    sessions_7d,
    future_value_90d AS observed_future_value_90d,
    predicted_future_value_90d AS predicted_future_value_90d_raw,
    GREATEST(predicted_future_value_90d, 0) AS predicted_future_value_90d,
    dt,
    source_file_name
  FROM ML.PREDICT(
    MODEL ${ref("customer_pltv_model")},
    (
      SELECT
        f.customer_key,
        f.acquisition_date,
        f.city_standard AS city_standard_output,
        f.acquisition_platform AS acquisition_platform_output,
        f.acquisition_campaign_id,
        f.acquisition_ad_id,
        f.acquisition_attribution_method AS acquisition_attribution_method_output,
        f.future_value_90d,
        f.dt,
        f.source_file_name,
        f.acquisition_month,
        f.acquisition_iso_week,
        COALESCE(f.city_standard, "Unknown") AS city_standard,
        COALESCE(f.has_guest_identity, FALSE) AS has_guest_identity,
        COALESCE(f.marketing_opt_in, FALSE) AS marketing_opt_in,
        COALESCE(f.is_placeholder, FALSE) AS is_placeholder,
        COALESCE(f.days_from_signup_to_first_order, -1) AS days_from_signup_to_first_order,
        COALESCE(f.acquisition_platform, "unattributed") AS acquisition_platform,
        COALESCE(f.acquisition_attribution_method, "unattributed") AS acquisition_attribution_method,
        f.orders_7d,
        f.completed_orders_7d,
        f.refunded_orders_7d,
        f.completed_revenue_7d,
        COALESCE(f.avg_completed_order_value_7d, 0) AS avg_completed_order_value_7d,
        f.discount_7d,
        f.items_7d,
        f.sessions_7d,
        f.click_id_sessions_7d,
        f.utm_sessions_7d,
        f.distinct_campaigns_7d,
        f.events_7d,
        f.engagement_time_msec_7d,
        COALESCE(f.first_device_category, "unknown") AS first_device_category
      FROM ${ref("mart_customer_features")} AS f
      CROSS JOIN data_end AS d
      WHERE f.acquisition_date <= DATE_SUB(d.max_observed_date, INTERVAL 7 DAY)
    )
  )
),

ranked AS (
  SELECT
    *,
    NTILE(3) OVER (
      ORDER BY predicted_future_value_90d DESC, customer_key
    ) AS value_tertile
  FROM predictions
)

SELECT
  customer_key,
  acquisition_date,
  city_standard,
  acquisition_platform,
  acquisition_campaign_id,
  acquisition_ad_id,
  acquisition_attribution_method,
  completed_revenue_7d,
  sessions_7d,
  observed_future_value_90d,
  predicted_future_value_90d_raw,
  predicted_future_value_90d,
  CASE value_tertile
    WHEN 1 THEN "high"
    WHEN 2 THEN "steady"
    ELSE "low"
  END AS value_segment,
  CURRENT_TIMESTAMP() AS scored_at_utc,
  dt,
  source_file_name
FROM ranked
